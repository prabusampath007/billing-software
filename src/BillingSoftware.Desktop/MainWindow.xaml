<Window x:Class="BillingSoftware.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Billing Software" Width="1280" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Header: the shop name on the left, who is signed in and lock / sign out on the right -->
        <Border Background="{StaticResource HeaderBrush}" BorderBrush="#A9C6E6" BorderThickness="0,0,0,1" MinHeight="56">
            <Grid Margin="16,6,12,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BusinessText" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420"/>
                        <TextBlock x:Name="BrandText" Text="Billing Software" Foreground="#4B5B75" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13" MaxWidth="220"/>
                    <Button x:Name="LockButton" Click="Lock_Click" Style="{StaticResource HeaderButton}" ToolTip="Lock the screen (Ctrl+L)" AutomationProperties.Name="Lock screen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LockLabel" Text="Lock" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SignOutButton" Click="SignOut_Click" Style="{StaticResource HeaderButton}" ToolTip="Sign out" AutomationProperties.Name="Sign out">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SignOutLabel" Text="Sign out" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon rail: one icon for each section of the program -->
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavItems" Margin="0,8,0,8"/>
                </ScrollViewer>
            </Border>

            <!-- Content: tabs for the pages of the chosen section, then the page -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="Banner" Background="{StaticResource WarnBackBrush}" Padding="16,8" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="BannerText" Foreground="{StaticResource WarnTextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="BannerButton" Grid.Column="1" Content="Open settings" Margin="12,0,0,0" MinHeight="30" Padding="10,3" Click="Banner_Click"/>
                    </Grid>
                </Border>
                <Border x:Name="TabStrip" Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TabItems" Orientation="Horizontal" Margin="8,0,8,0"/>
                    </ScrollViewer>
                </Border>
                <ContentControl x:Name="Host" Grid.Row="2" IsTabStop="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
