<Window x:Class="BillingSoftware.Desktop.Views.PurchaseEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="New purchase" Width="1180" Height="740" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PayNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaymentOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="380"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Items bought -->
            <Border x:Name="ItemsPane" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="New purchase" Style="{StaticResource H1}"/>
                        <TextBlock Text="Scan a barcode or type an item name or code, then press Enter" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" MinHeight="42" AutomationProperties.Name="Scan barcode or search item">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ScanCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Add" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinHeight="42" MinWidth="70"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="1" Visibility="{Binding HasMatches, Converter={StaticResource B2V}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                        <ListBox x:Name="MatchList" ItemsSource="{Binding Matches}" MaxHeight="170" BorderThickness="0" MouseDoubleClick="MatchList_DoubleClick" KeyDown="MatchList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Sku}" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="ItemsGrid" ItemsSource="{Binding Lines}" IsReadOnly="False" Margin="0,12,0,0" MinHeight="220" AutomationProperties.Name="Items bought">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Qty" Width="64" Binding="{Binding Quantity, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Cost ₹" Width="80" Binding="{Binding UnitCost, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="GST %" Width="64" Binding="{Binding GstPercent, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Disc ₹" Width="70" Binding="{Binding Discount, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTemplateColumn Header="Credit" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ItcEligible, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanClaimCredit}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                  ToolTip="Claim GST input credit on this item" AutomationProperties.Name="Claim input credit"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total" Width="92" IsReadOnly="True" Binding="{Binding TotalText}" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Width="46" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="0" MinHeight="28" MinWidth="28" Margin="0" ToolTip="Remove this item" AutomationProperties.Name="Remove item"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Supplier, totals and payment -->
            <Border x:Name="PayPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding PaymentNote}" Style="{StaticResource PayNote}" Margin="0,0,0,10"/>
                            <Button Content="Save purchase" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinHeight="48" FontSize="16" HorizontalAlignment="Stretch" Margin="0"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="PayScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Supplier" Style="{StaticResource H2}"/>
                            <StackPanel Visibility="{Binding HasSupplier, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SupplierText}"/>
                                <Button Content="Change supplier" Command="{Binding ClearSupplierCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasSupplier}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBox Text="{Binding SupplierQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find supplier by name or phone">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchSupplierCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Type a name or phone and press Enter (empty lists all)" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                <ListBox ItemsSource="{Binding SupplierMatches}" MaxHeight="130" Margin="0,6,0,0" SelectionChanged="SupplierList_SelectionChanged"
                                         Visibility="{Binding HasSupplierMatches, Converter={StaticResource B2V}}">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <TextBlock Text="Supplier's invoice number *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Supplier invoice number"/>
                            <TextBlock Text="Invoice date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding InvoiceDate}" AutomationProperties.Name="Supplier invoice date"/>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="1" Text="Taxable value"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxableText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="GST"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Text="Round off"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RoundOffText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Text="TOTAL" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" Margin="12,6,0,0" TextWrapping="NoWrap"
                                               HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="Purchase total"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Payment" Style="{StaticResource H2}" Margin="0,14,0,0"/>
                            <TextBlock Text="Cash (empty = the rest)" Style="{StaticResource FieldLabel}" Margin="0,6,0,3"/>
                            <TextBox Text="{Binding CashText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Cash paid"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UPI" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding UpiText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="UPI amount"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Card" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding CardText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Card amount"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="On account (pay the supplier later)" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Amount owed to supplier"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
