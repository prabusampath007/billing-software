<Window x:Class="BillingSoftware.Desktop.Views.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Admin approval" Width="460" SizeToContent="Height" MinWidth="340" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Admin approval needed" Style="{StaticResource H2}"/>
            <TextBlock x:Name="MessageText" Margin="0,8,0,0"/>
            <TextBlock Text="Admin password" Style="{StaticResource FieldLabel}" Margin="0,16,0,3"/>
            <PasswordBox x:Name="PasswordInput"/>
            <Border x:Name="ErrorBox" Background="{StaticResource ErrorBackBrush}" CornerRadius="4" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True"/>
                <Button x:Name="ApproveButton" Content="Approve" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Approve_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
