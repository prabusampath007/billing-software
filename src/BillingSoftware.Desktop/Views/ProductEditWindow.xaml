<Window x:Class="BillingSoftware.Desktop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Item" Width="940" SizeToContent="Height" MinWidth="360" MinHeight="300"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource DialogHeaderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{StaticResource DialogHeaderBrush}" Padding="20,10,10,10" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FormTitle}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <Button Grid.Column="1" Content="&#x2715;" Command="{Binding CloseFormCommand}" Background="Transparent" BorderBrush="Transparent" Foreground="White" MinHeight="32" MinWidth="36" Padding="8,2" Margin="0"
                            ToolTip="Close without saving (Esc)" AutomationProperties.Name="Close the item dialog"/>
                </Grid>
            </Border>

            <!-- Body: two columns of cards; one column when the window is narrow -->
            <ScrollViewer Grid.Row="1" x:Name="BodyScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="Cards" Margin="16,16,16,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel x:Name="LeftStack" Margin="0,0,8,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Item details" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Item name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name"/>
                                <TextBlock Text="Tamil name (printed on receipts)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding TamilName, UpdateSourceTrigger=PropertyChanged}" FontFamily="Nirmala UI, Latha, Segoe UI" FontSize="15" MaxLength="120" AutomationProperties.Name="Tamil name" ToolTip="Type the name in Tamil. Receipts show it instead of the English name."/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Item code (optional)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Sku}" AutomationProperties.Name="Item code" ToolTip="Leave empty and one is made for you (ITEM-00001...)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Units}" Text="{Binding Unit, UpdateSourceTrigger=LostFocus}" IsEditable="True" AutomationProperties.Name="Unit"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Active (can be sold)" IsChecked="{Binding IsActive}"/>
                                <TextBlock Text="{Binding StockInfo}" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="To add stock or adjust it, use the Stock tab." Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Price and tax" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Selling price (₹) *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PriceText}" HorizontalContentAlignment="Right" AutomationProperties.Name="Selling price"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="MRP (₹)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MrpText}" HorizontalContentAlignment="Right" AutomationProperties.Name="MRP"/></StackPanel>
                                </Grid>
                                <CheckBox Content="Price already includes GST (MRP style)" IsChecked="{Binding PriceInclusive}" Visibility="{Binding ShowGst, Converter={StaticResource B2V}}"/>
                                <Grid Visibility="{Binding ShowGst, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="GST rate (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding GstText}" HorizontalContentAlignment="Right" AutomationProperties.Name="GST rate"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="HSN code" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Hsn}" AutomationProperties.Name="HSN code"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RightStack" Grid.Column="1" Margin="8,0,0,0">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Barcodes" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Barcode}" AutomationProperties.Name="Barcode"/>
                                <Button Content="Make a barcode for this item" Command="{Binding GenerateBarcodeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                                    <TextBlock Text="Extra barcodes (packs, cartons, loose quantities)" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,0"
                                               Text="Scanning an extra barcode adds that quantity of this item to the bill, at this item's price. For a pack with its own price, make it a separate item and repack on the Stock tab."/>
                                    <ListBox ItemsSource="{Binding Extras}" SelectedItem="{Binding SelectedExtra}" DisplayMemberPath="Text" MinHeight="40" MaxHeight="120" Margin="0,8,0,0" AutomationProperties.Name="Extra barcodes"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ExtraCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Extra barcode" ToolTip="Scan or type the extra barcode"/>
                                        <TextBox Grid.Column="2" Text="{Binding ExtraQtyText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Quantity one scan adds" ToolTip="Quantity one scan adds"/>
                                    </Grid>
                                    <TextBlock Text="Barcode, then the quantity one scan adds" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    <TextBox Text="{Binding ExtraNote}" MaxLength="80" Margin="0,6,0,0" AutomationProperties.Name="Extra barcode note" ToolTip="Note, for example 250 g pack"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Add barcode" Command="{Binding AddExtraCommand}" Margin="0,0,8,6"/>
                                        <Button Content="Make a code" Command="{Binding GenerateExtraCodeCommand}" Margin="0,0,8,6"/>
                                        <Button Content="Remove selected" Command="{Binding RemoveExtraCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsExisting, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="Barcode labels" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Prints labels for the selected extra barcode, or for this item's own barcode if none is selected. Only 13-digit EAN barcodes can be printed."/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LabelCopiesText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Number of labels" ToolTip="Number of labels"/>
                                    <Button Grid.Column="2" Content="Print labels" Command="{Binding PrintLabelsCommand}" HorizontalAlignment="Left" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CloseFormCommand}" MinWidth="90" AutomationProperties.Name="Cancel"/>
                        <Button Content="Save item" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0" AutomationProperties.Name="Save item"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
