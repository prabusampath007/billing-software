<UserControl x:Class="BillingSoftware.Desktop.Views.OpeningBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BillingSoftware.Desktop.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpeningRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoided}" Value="True"><Setter Property="Foreground" Value="#8A93A3"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="400"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- What has been entered -->
            <Border x:Name="ListPane" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Opening balances" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding Guidance}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Margin="0,8,0,0" MinHeight="220">
                        <TabItem Header="Entries">
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" RowStyle="{StaticResource OpeningRowStyle}" AutomationProperties.Name="Opening balance entries">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="As at" Binding="{Binding DateText}" Width="90"/>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="170"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Starting position">
                            <DataGrid ItemsSource="{Binding Summary}" AutomationProperties.Name="Starting position">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding Label}" Width="260"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Value}" Width="140" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>
                        <Button Content="Cancel this entry" Command="{Binding CancelEntryCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Add an opening balance -->
            <Border x:Name="FormPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,0,0,10"/>
                            <Button Content="Save balance" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinHeight="46" FontSize="16" HorizontalAlignment="Stretch" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Add a balance" Style="{StaticResource H2}"/>
                            <TextBlock Text="What kind of balance" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Label" AutomationProperties.Name="Kind of balance"/>
                            <TextBlock Text="{Binding Kind.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding CashBlockedText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding CashBlocked, Converter={StaticResource B2V}}"/>

                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding Date}" AutomationProperties.Name="As at date"/>

                            <StackPanel Visibility="{Binding ShowCustomer, Converter={StaticResource B2V}}">
                                <TextBlock Text="Customer *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" AutomationProperties.Name="Customer"/>
                                <TextBlock Text="Add the customer on the Customers screen first if they are not in this list." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowSupplier, Converter={StaticResource B2V}}">
                                <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SupplierList}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" AutomationProperties.Name="Supplier"/>
                                <TextBlock Text="Add the supplier on the Suppliers screen first if they are not in this list." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowName, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding NameLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Name"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" FontSize="16" AutomationProperties.Name="Amount"/>
                            <StackPanel Visibility="{Binding ShowCost, Converter={StaticResource B2V}}">
                                <TextBlock Text="Original cost (₹), if you know it" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Original cost"/>
                            </StackPanel>
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Note}" MaxLength="200" AutomationProperties.Name="Note"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
