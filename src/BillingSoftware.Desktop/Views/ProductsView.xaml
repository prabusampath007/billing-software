<UserControl x:Class="BillingSoftware.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ItemRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Product.IsActive}" Value="False"><Setter Property="Foreground" Value="#8A93A3"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Padding="16,14" Margin="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Items" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ New item" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Top" MinHeight="38"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxWidth="520" HorizontalAlignment="Left" Width="520" AutomationProperties.Name="Search items" ToolTip="Search by name, Tamil name, code or barcode. Results follow your typing.">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="14,0,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>
                <DataGrid x:Name="ItemGrid" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" RowStyle="{StaticResource ItemRowStyle}"
                          Margin="0,12,0,0" MinHeight="200" AutomationProperties.Name="Item list">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
                        <DataGridTextColumn Header="Tamil name" Binding="{Binding TamilName}" Width="1.4*" MinWidth="110"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Sku}" Width="100"/>
                        <DataGridTextColumn Header="HSN" Binding="{Binding Hsn}" Width="80"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding PriceText}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="GST" Binding="{Binding GstText}" Width="64" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="On hand" Binding="{Binding StockText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
    </Border>
</UserControl>
