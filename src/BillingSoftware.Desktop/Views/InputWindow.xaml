<Window x:Class="BillingSoftware.Desktop.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" MinWidth="340" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="MessageText"/>
            <TextBox x:Name="PlainInput" Margin="0,12,0,0" AutomationProperties.Name="Value"/>
            <PasswordBox x:Name="SecretInput" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.Name="Value"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True"/>
                <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Padding="24,7" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
