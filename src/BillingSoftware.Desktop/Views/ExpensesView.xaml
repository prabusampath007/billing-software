<UserControl x:Class="BillingSoftware.Desktop.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BillingSoftware.Desktop.Views">
    <UserControl.Resources>
        <v:PaiseConverter x:Key="Paise"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpenseRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoided}" Value="True"><Setter Property="Foreground" Value="#8A93A3"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="400"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Expenses list -->
            <Border x:Name="ListPane" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Expenses" Style="{StaticResource H1}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <DatePicker SelectedDate="{Binding From}" MinWidth="130" Margin="0,0,10,6" AutomationProperties.Name="From date"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <DatePicker SelectedDate="{Binding To}" MinWidth="130" Margin="0,0,12,6" AutomationProperties.Name="To date"/>
                            <ComboBox ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}" DisplayMemberPath="Name" MinWidth="190" Margin="0,0,12,6" AutomationProperties.Name="Category filter"/>
                            <CheckBox Content="Not paid yet" IsChecked="{Binding UnpaidOnly}" Margin="0,6,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Margin="0,8,0,0" MinHeight="220">
                        <TabItem Header="All expenses">
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" RowStyle="{StaticResource ExpenseRowStyle}" AutomationProperties.Name="Expenses">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="170"/>
                                    <DataGridTextColumn Header="Paid to / for" Binding="{Binding Text}" Width="260"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Paid by" Binding="{Binding PaidByText}" Width="90"/>
                                    <DataGridTextColumn Header="To pay" Binding="{Binding OutstandingText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="GST credit" Binding="{Binding CreditText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="By category">
                            <DataGrid ItemsSource="{Binding ByCategory}" AutomationProperties.Name="Expenses by category">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="260"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPaise, Converter={StaticResource Paise}}" Width="140" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Record an expense -->
            <Border x:Name="FormPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,0,0,10"/>
                            <Button Content="Save expense" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinHeight="46" FontSize="16" HorizontalAlignment="Stretch" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Record an expense" Style="{StaticResource H2}"/>
                            <TextBlock Text="Date it belongs to" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding Date}" AutomationProperties.Name="Expense date"/>
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" AutomationProperties.Name="Category"/>
                            <TextBlock Text="Paid to" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PayTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Paid to"/>
                            <TextBlock Text="What it was for" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="What it was for"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Amount (₹) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" FontSize="16" AutomationProperties.Name="Amount"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bill / reference" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Reference}" MaxLength="40" AutomationProperties.Name="Reference"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Paid by" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding PayOptions}" SelectedItem="{Binding PayOption}" DisplayMemberPath="Label" AutomationProperties.Name="Paid by"/>
                            <StackPanel Visibility="{Binding ShowGst, Converter={StaticResource B2V}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GST in the amount (₹)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding GstText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="GST in the amount"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Supplier GSTIN" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SupplierGstin}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="Supplier GSTIN"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Claim the GST as input credit" IsChecked="{Binding ClaimCredit}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding GstSummaryText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Credit needs the GST amount, the supplier's GSTIN and the bill number from a tax invoice. Without a claim the GST stays part of the cost."/>
                            </StackPanel>

                            <TextBlock Text="Selected expense" Style="{StaticResource H2}" Margin="0,20,0,0"/>
                            <TextBlock Text="{Binding SelectionText}" Margin="0,4,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SettleAmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Amount paying now" ToolTip="Amount paying now (₹)"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding SettleOptions}" SelectedItem="{Binding SettleOption}" DisplayMemberPath="Label" AutomationProperties.Name="Paid now by"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Pay now" Command="{Binding PayCommand}" Margin="0,0,8,6"/>
                                <Button Content="Cancel this expense" Command="{Binding CancelExpenseCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,6"/>
                            </WrapPanel>

                            <TextBlock Text="Add a category" Style="{StaticResource H2}" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="New category name"/>
                                <Button Grid.Column="1" Content="Add" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
