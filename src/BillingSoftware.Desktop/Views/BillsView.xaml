<UserControl x:Class="BillingSoftware.Desktop.Views.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Bills" Style="{StaticResource H1}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <DatePicker SelectedDate="{Binding Date}" MinWidth="150" Margin="0,0,8,6" AutomationProperties.Name="Bill date"/>
                        <Button Content="Today" Command="{Binding TodayCommand}" Margin="0,0,8,6"/>
                        <Button Content="Previous day" Command="{Binding PreviousCommand}" Margin="0,0,8,6"/>
                        <Button Content="View / reprint" Command="{Binding ViewCommand}" Margin="0,0,8,6"/>
                        <Button Content="A4 invoice" Command="{Binding PrintA4Command}" Margin="0,0,8,6" AutomationProperties.Name="Print an A4 invoice"/>
                        <Button Content="Return items..." Command="{Binding ReturnItemsCommand}" Margin="0,0,8,6"/>
                        <Button Content="Void bill" Command="{Binding VoidCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,10,0,0" MinHeight="200" AutomationProperties.Name="Bills">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill no." Binding="{Binding InvoiceNumber}" Width="150"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="64"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="Cashier" Binding="{Binding Cashier}" Width="120"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="Returns (credit notes) on this day" Style="{StaticResource H2}"/>
                    <DataGrid ItemsSource="{Binding ReturnRows}" SelectedItem="{Binding SelectedReturn, Mode=TwoWay}" Margin="0,8,0,0" MinHeight="80" MaxHeight="160" AutomationProperties.Name="Credit notes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Credit note" Binding="{Binding Number}" Width="150"/>
                            <DataGridTextColumn Header="Against bill" Binding="{Binding Against}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding TotalText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="View credit note" Command="{Binding ViewReturnCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
