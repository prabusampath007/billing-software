<UserControl x:Class="BillingSoftware.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="380"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Border x:Name="ListPane" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Suppliers" Style="{StaticResource H1}"/>
                            <Button Grid.Column="1" Content="+ New supplier" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                        </Grid>
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" AutomationProperties.Name="Search suppliers" ToolTip="Search by name or phone">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,10,0,0" MinHeight="220" AutomationProperties.Name="Suppliers">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="You owe (₹)" Binding="{Binding OwedText}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="FormPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource H2}"/>
                        <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier name"/>
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Phone}" AutomationProperties.Name="Phone"/>
                        <TextBlock Text="State (decides CGST/SGST or IGST on purchases)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Display" AutomationProperties.Name="State"/>
                        <TextBlock Text="GSTIN" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Gstin}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN"/>
                        <Button Content="Save supplier" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch" MinHeight="42"/>

                        <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource B2V}}" Margin="0,20,0,0">
                            <TextBlock Text="Pay supplier" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding OwedText}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="Amount paid (₹)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Amount paid"/>
                            <TextBlock Text="Paid by" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding PayMode}" DisplayMemberPath="Label" AutomationProperties.Name="Payment mode"/>
                            <Button Content="Record payment" Command="{Binding PayCommand}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
