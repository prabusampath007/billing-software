<UserControl x:Class="BillingSoftware.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PayNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PaymentOk}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CompleteCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ScanCommand}" Modifiers="Control"/>
    </UserControl.InputBindings>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SecondColumn" Width="360"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bill items -->
            <Border x:Name="CartPane" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="New bill" Style="{StaticResource H1}"/>
                        <TextBlock Text="Scan a barcode, or type an item name or code: matching items appear as you type. Press Enter to add." Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" MinHeight="42"
                                     AutomationProperties.Name="Scan barcode or search item" PreviewKeyDown="ScanBox_PreviewKeyDown">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ScanCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Add" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinHeight="42" MinWidth="70"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Visibility="{Binding HasMatches, Converter={StaticResource B2V}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                        <ListBox x:Name="MatchList" ItemsSource="{Binding Matches}" MaxHeight="190" BorderThickness="0"
                                 MouseDoubleClick="MatchList_DoubleClick" KeyDown="MatchList_KeyDown" AutomationProperties.Name="Matching items">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Sku}" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" TextWrapping="NoWrap" FontWeight="SemiBold" Margin="12,0,0,0" MinWidth="64" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="CartGrid" ItemsSource="{Binding Lines}" IsReadOnly="False" Margin="0,12,0,0" MinHeight="220"
                              SelectionUnit="FullRow" AutomationProperties.Name="Bill items">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Item" Width="*" MinWidth="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                                                       Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Qty" Width="72" Binding="{Binding Quantity, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Price" Width="86" IsReadOnly="True" Binding="{Binding PriceText}" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Disc ₹" Width="76" Binding="{Binding Discount, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Total" Width="96" IsReadOnly="True" Binding="{Binding TotalText}" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Width="48" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="0" MinHeight="28" MinWidth="28" Margin="0" ToolTip="Remove this item"
                                                AutomationProperties.Name="Remove item"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Totals and payment -->
            <Border x:Name="PayPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <!-- Always visible: the sale buttons never scroll away -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding PaymentNote}" Style="{StaticResource PayNote}" Margin="0,0,0,10"/>
                            <Button Content="Complete sale  (F12)" Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButton}"
                                    MinHeight="48" FontSize="16" HorizontalAlignment="Stretch" Margin="0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Hold bill" Command="{Binding HoldCommand}" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="Hold this bill"/>
                                <Button Grid.Column="2" Content="{Binding HeldText}" Command="{Binding RecallCommand}" HorizontalAlignment="Stretch" Margin="0" AutomationProperties.Name="Held bills"/>
                            </Grid>
                            <Button Content="Clear bill" Command="{Binding ClearCartCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="PayScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Customer" Style="{StaticResource H2}"/>
                            <StackPanel Visibility="{Binding HasCustomer, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CustomerText}"/>
                                <Button Content="Use walk-in customer" Command="{Binding ClearCustomerCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel x:Name="CustomerPicker" Margin="0,6,0,0">
                                <TextBox Text="{Binding CustomerQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find customer by name or phone"
                                         ToolTip="Walk-in customer unless you search and pick one (needed for credit sales)">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCustomerCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Walk-in unless you type a name or phone and press Enter" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                <ListBox ItemsSource="{Binding CustomerMatches}" MaxHeight="120" Margin="0,6,0,0" SelectionChanged="CustomerList_SelectionChanged"
                                         Visibility="{Binding HasCustomerMatches, Converter={StaticResource B2V}}">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="1" Text="Taxable value" Visibility="{Binding ShowTax, Converter={StaticResource B2V}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxableText}" HorizontalAlignment="Right" Visibility="{Binding ShowTax, Converter={StaticResource B2V}}"/>
                                    <TextBlock Grid.Row="2" Text="GST" Visibility="{Binding ShowTax, Converter={StaticResource B2V}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxText}" HorizontalAlignment="Right" Visibility="{Binding ShowTax, Converter={StaticResource B2V}}"/>
                                    <TextBlock Grid.Row="3" Text="Discount"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscountText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Text="Round off"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoundOffText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="5" Text="TOTAL" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" Margin="12,6,0,0" TextWrapping="NoWrap"
                                               HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="Bill total"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Payment" Style="{StaticResource H2}" Margin="0,14,0,0"/>
                            <TextBlock Text="Cash received (empty = exact cash)" Style="{StaticResource FieldLabel}" Margin="0,6,0,3"/>
                            <TextBox Text="{Binding CashText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cash received" HorizontalContentAlignment="Right"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UPI" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding UpiText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="UPI amount" HorizontalContentAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Card" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding CardText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Card amount" HorizontalContentAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="On credit (customer pays later)" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Credit amount" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
