<UserControl x:Class="BillingSoftware.Desktop.Views.DayEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DifferenceText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DifferenceKind}" Value="1"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding DifferenceKind}" Value="2"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="LineTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="16,0,0,0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="400"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="FirstRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- What the books say -->
            <Border x:Name="LeftPane" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="LeftScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="Day end" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                        <TextBlock Text="Cash that should be in the drawer" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding ExpectedText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" AutomationProperties.Name="Expected cash"/>
                        <Border Background="{StaticResource WarnBackBrush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding ExpectedNegative, Converter={StaticResource B2V}}">
                            <TextBlock Foreground="{StaticResource WarnTextBrush}"
                                       Text="The books say the drawer should hold less than zero. Check the pay-outs, deposits and cash purchases below."/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding CashLines}" ItemTemplate="{StaticResource LineTemplate}" Margin="0,10,0,0"/>

                        <TextBlock Text="Sales in this period" Style="{StaticResource H2}" Margin="0,22,0,4"/>
                        <ItemsControl ItemsSource="{Binding SalesLines}" ItemTemplate="{StaticResource LineTemplate}"/>

                        <TextBlock Text="Money in and out of the drawer" Style="{StaticResource H2}" Margin="0,22,0,0"/>
                        <TextBlock Text="Record anything taken out or put in besides sales and purchases, before you count." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding MovementType}" DisplayMemberPath="Label" Margin="0,8,0,0" AutomationProperties.Name="What the money was for"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MovementAmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Amount" ToolTip="Amount (₹)"/>
                            <TextBox Grid.Column="2" Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reason" ToolTip="What it was for"/>
                        </Grid>
                        <TextBlock Text="Amount (₹), then what it was for" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                        <Button Content="Record" Command="{Binding RecordMovementCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <ItemsControl ItemsSource="{Binding Movements}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Count and close -->
            <Border x:Name="RightPane" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,0,0,10"/>
                            <Button Content="Close the day" Command="{Binding CloseDayCommand}" Style="{StaticResource PrimaryButton}" MinHeight="48" FontSize="16" HorizontalAlignment="Stretch" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="RightScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Count the cash" Style="{StaticResource H2}"/>
                            <StackPanel Visibility="{Binding AskForOpeningCash, Converter={StaticResource B2V}}">
                                <TextBlock Text="Cash that was in the drawer when you started (₹)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OpeningFloatText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" AutomationProperties.Name="Opening cash"/>
                                <TextBlock Text="Only asked once, at the first close." Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Cash counted in the drawer now (₹)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" FontSize="20" MinHeight="46" AutomationProperties.Name="Cash counted"/>
                            <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource DifferenceText}"/>
                            <StackPanel Visibility="{Binding NeedsNote, Converter={StaticResource B2V}}">
                                <TextBlock Text="Note (required when the cash does not match)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top" AutomationProperties.Name="Note about the difference"/>
                            </StackPanel>

                            <TextBlock Text="Earlier closes" Style="{StaticResource H2}" Margin="0,22,0,6"/>
                            <DataGrid ItemsSource="{Binding Closes}" SelectedItem="{Binding SelectedClose, Mode=TwoWay}" MinHeight="110" MaxHeight="240" AutomationProperties.Name="Earlier closes">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Closed at" Binding="{Binding DateText}" Width="130"/>
                                    <DataGridTextColumn Header="Counted" Binding="{Binding CountedText}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                                    <DataGridTextColumn Header="Diff" Binding="{Binding DifferenceText}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
