<UserControl x:Class="BillingSoftware.Desktop.Views.ProfitLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BillingSoftware.Desktop.Views">
    <UserControl.Resources>
        <v:PaiseConverter x:Key="Paise"/>
        <v:QtyConverter x:Key="QtyFmt"/>
        <v:BpConverter x:Key="Bp"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="StatementRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Heading"><Setter Property="Background" Value="#EEF2FA"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Subtotal"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Total"><Setter Property="Background" Value="#DCE6F7"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Percent"><Setter Property="Foreground" Value="#5C6678"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeadlineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoss}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Root" Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Profit and loss" Style="{StaticResource H1}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" DisplayMemberPath="Label" MinWidth="190" Margin="0,0,10,6" AutomationProperties.Name="Period"/>
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <DatePicker SelectedDate="{Binding From}" MinWidth="140" Margin="0,0,10,6" AutomationProperties.Name="From date"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <DatePicker SelectedDate="{Binding To}" MinWidth="140" Margin="0,0,14,6" AutomationProperties.Name="To date"/>
                        <Button Content="Prepare" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,8,6"/>
                        <Button Content="Save to Excel..." Command="{Binding ExportCommand}" Margin="0,0,8,6"/>
                        <Button Content="View printable statement" Command="{Binding PrintCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <TabControl Visibility="{Binding HasReport, Converter={StaticResource B2V}}" MinHeight="300">
                    <TabItem Header="Statement">
                        <DataGrid ItemsSource="{Binding Rows}" RowStyle="{StaticResource StatementRow}" AutomationProperties.Name="Profit and loss statement">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Label}" Width="380"/>
                                <DataGridTextColumn Header="This period" Binding="{Binding Current}" Width="150" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Before" Binding="{Binding Previous}" Width="150" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="140" ElementStyle="{StaticResource RightCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Profit by item">
                        <DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Profit by item">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="280"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding QtyMilli, Converter={StaticResource QtyFmt}}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Sales" Binding="{Binding SalesPaise, Converter={StaticResource Paise}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostPaise, Converter={StaticResource Paise}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Profit" Binding="{Binding ProfitPaise, Converter={StaticResource Paise}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="Margin" Binding="{Binding MarginBp, Converter={StaticResource Bp}}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="How to read this">
                        <ListBox ItemsSource="{Binding Notes}" BorderThickness="0" Margin="0,6" AutomationProperties.Name="Notes">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,4,12,4"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
