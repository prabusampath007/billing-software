<Window x:Class="BillingSoftware.Desktop.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="First-time setup" Width="660" Height="720" MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource Card}" Margin="16" MaxWidth="620">
            <StackPanel>
                <TextBlock Text="Welcome. Let's set up your shop" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="This takes a minute. You can change the business details later in Settings."/>

                <TextBlock Text="Business" Style="{StaticResource H2}" Margin="0,20,0,0"/>
                <TextBlock Text="Business name *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BusinessName" AutomationProperties.Name="Business name"/>
                <TextBlock Text="State *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StateBox" DisplayMemberPath="Display" AutomationProperties.Name="State"/>
                <TextBlock Text="GSTIN (leave empty if not registered)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Gstin" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN"/>
                <CheckBox x:Name="GstOn" Content="Charge GST on bills (untick if the business does not charge GST)" IsChecked="True" Margin="0,10,0,0" AutomationProperties.Name="Charge GST"/>
                <CheckBox x:Name="Composition" Content="We are under the GST composition scheme (bill of supply, no tax shown)" IsEnabled="{Binding IsChecked, ElementName=GstOn}"/>
                <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Address" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top"/>
                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Phone"/>

                <TextBlock Text="Owner (Admin) account" Style="{StaticResource H2}" Margin="0,24,0,0"/>
                <TextBlock Text="Your name *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DisplayName" AutomationProperties.Name="Your name"/>
                <TextBlock Text="Username *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Username" AutomationProperties.Name="Username"/>
                <TextBlock Text="Password * (at least 8 characters)" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="Password" AutomationProperties.Name="Password"/>
                <TextBlock Text="Confirm password *" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="Confirm" AutomationProperties.Name="Confirm password"/>

                <Border x:Name="ErrorBox" Background="{StaticResource ErrorBackBrush}" CornerRadius="4" Padding="10,6" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"/>
                </Border>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Exit" HorizontalAlignment="Left" Click="Exit_Click"/>
                        <Button Content="I already have a backup..." Click="Restore_Click" Margin="8,0,0,0" AutomationProperties.Name="Restore from a backup"/>
                    </StackPanel>
                    <Button x:Name="CreateButton" Grid.Column="1" Content="Create and continue" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Padding="22,7" Click="Create_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
