<Window x:Class="BillingSoftware.Desktop.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Bill" Width="400" Height="640" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Print to..." Click="PrintDialog_Click" Margin="0,0,8,0"/>
            <Button x:Name="PrintButton" Content="Print (Enter)" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Print_Click"/>
        </WrapPanel>
        <Border Style="{StaticResource Card}" Padding="0" Background="White">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      IsToolBarVisible="False" Zoom="100" Background="White"/>
        </Border>
    </DockPanel>
</Window>
